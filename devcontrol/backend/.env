# --- Core ---
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://devcontrol:devcontrol@db:5432/devcontrol

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Monitoring ---
DEFAULT_CHECK_INTERVAL_SECONDS=300
SSL_WARNING_DAYS=30
SSL_URGENT_DAYS=14
SSL_CRITICAL_DAYS=7

# --- Notifications (never expose these to the frontend) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@devcontrol.app

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Project filesystem sandbox ---
ALLOWED_PROJECT_ROOT=/data/projects
BACKUP_STORAGE_PATH=/data/backups
